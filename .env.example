# =============================================
# 企业内部知识管理平台 · 环境变量配置
# 复制此文件为 .env 并填写实际值
# =============================================

# 应用环境
NODE_ENV=development
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:4000
AI_ENGINE_URL=http://localhost:8000

# 数据库
DATABASE_URL=postgresql://postgres:password@localhost:5432/intranet

# Redis
REDIS_URL=redis://localhost:6379

# 对象存储 - MinIO (本地开发)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=intranet-docs

# 对象存储 - 阿里云 OSS (生产，二选一)
# OSS_REGION=cn-hangzhou
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_BUCKET=

# JWT 认证
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_USE_RANDOM_64_CHAR_STRING
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET
JWT_REFRESH_EXPIRES_IN=7d

# 邮件服务 (SMTP)
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your@company.com
SMTP_PASS=your-smtp-authorization-code
EMAIL_FROM="企业内网平台 <noreply@company.com>"

# 企业邮箱域名白名单（多个域名用逗号分隔，不含 @）
ALLOWED_EMAIL_DOMAINS=company.com

# OTP 配置
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60

# AI - Anthropic
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx
AI_MODEL=claude-sonnet-4-20250514
AI_MAX_TOKENS=2048

# AI - Embedding (OpenAI)
OPENAI_API_KEY=sk-xxxxxxxxxxxxx
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# 向量数据库 Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=intranet_docs
QDRANT_API_KEY=

# RAG 配置
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_TOP_K=10
RAG_RERANK_TOP_N=5

# 文件上传限制
UPLOAD_MAX_SIZE_MB=50
UPLOAD_ALLOWED_TYPES=pdf,docx,doc,txt,xlsx,xls,md

# 管理员初始账号（db seed 使用）
SEED_ADMIN_EMAIL=admin@company.com
SEED_ADMIN_PASSWORD=Admin@123456
SEED_ADMIN_NAME=系统管理员
